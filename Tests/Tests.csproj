    <None Update="BasicBoard.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="BasicBoardEdges.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
